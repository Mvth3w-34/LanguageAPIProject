@page "/userRegistration"
@using LanguageProjectFrontend.DtoModels
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@rendermode InteractiveServer
@inject NavigationManager NavigationManager

<PageTitle>Registration</PageTitle>
<section class="d-flex flex-column align-items-center">

    <EditForm Model="@_userCreateDto" OnValidSubmit="HandleValidSubmission" class="d-flex flex-column gap-2 w-75 p-4 rounded-2 bg-white">
        <DataAnnotationsValidator />
        <ValidationSummary />
        <div>
            <h1 class="text-center">Create New Subscription</h1>
        </div>
        <div>
            <label for="fname">First Name</label>
            <InputText id="fname" class="form-control" @bind-Value="@_userCreateDto.FirstName" />
        </div>
        <div >
            <label for="lname">Last Name</label>
            <InputText id="lname" class="form-control" @bind-Value="@_userCreateDto.LastName" />
        </div>
        <div>
            <label for="email">Email</label>
            <InputText id="email" class="form-control" @bind-Value="@_userCreateDto.Email" />
        </div>
        <div>
            <label for="frequency">Email Frequency</label>
            <InputSelect id="frequency" class="form-control" @bind-Value="@_userCreateDto.EmailFrequency">
                <option disabled selected value="">Select the frequency you would like to be emailed...</option>
                <option value="Daily">Daily</option>
                <option value="Weekly">Weekly</option>
                <option value="Month">Month</option>
            </InputSelect>
        </div>
        <div>
            <label for="preference">Language Preference</label>
            <InputSelect id="languagepreference" class="form-control" @bind-Value="@_userCreateDto.LanguagePreference">
                <option disabled selected value="">Select a language...</option>
                <option value="Swahili">Swahili</option>
                <option value="Arabic">Arabic</option>
                <option value="French">French</option>
            </InputSelect>
        </div>
        <button type="submit" class="btn btn-primary m-3">Submit</button>
    </EditForm>

</section>

@code {
    private UserCreateDto _userCreateDto = new UserCreateDto() { LastName="" };
    private string _port = Environment.GetEnvironmentVariable("PORT");

    private async Task HandleValidSubmission()
    {
        using var client = new HttpClient { BaseAddress = new Uri($"https://localhost:{_port}/") };//Prepare to send data to backend api
        var response = await client.PostAsJsonAsync("api/users", _userCreateDto); // Serialize _userCreateDto to JSON
        string isSuccess= (response.IsSuccessStatusCode) ? "true" :"false";
    
        NavigationManager.NavigateTo($"/successfulSubmission/success={isSuccess}");

    }

}
